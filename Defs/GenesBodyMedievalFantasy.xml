    <description></description>
    <iconPath>Storageborn/Bodies/Luggage/Storageborn_south</iconPath>
    <exclusionTags></exclusionTags>
    <modExtensions>
      <li Class="StoragebornXenotype.StoragebornBodyCategoryExtension">
        <OMW_StoragebornCategory>OMW_StoragebornCategory_MedievalFantasy</OMW_StoragebornCategory>
      </li>
      <li Class="StoragebornXenotype.StoragebornBodyBackstoriesExtension">
        <backgrounds>
          <li>OMW_StoragebornChildhood_NeolithicFantasyMimic</li>
        </backgrounds>
      </li>
      <li Class="StoragebornXenotype.StoragebornBodyGenesExtension">
