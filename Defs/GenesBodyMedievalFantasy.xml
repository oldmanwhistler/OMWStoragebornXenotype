        <li>AptitudeRemarkable_Social</li>
        <li>BS_Diet_Carnivore</li>
        <li>RobustDigestion</li>        
        <li>PsychicAbility_Dull</li>
        <li>Nearsighted</li>
        <li>BS_SnekEngulf</li>
        <li>BS_NoEquip</li>
        <li>Aggression_DeadCalm</li>
        <li>WoundHealing_SuperFast</li>        
        <li>Cannibal</li>   
        <li>Immunity_Strong</li>        
        <li MayRequire="sarg.alphagenes">AG_DevourBrains</li>              
        <li MayRequire="sarg.alphagenes">AG_PlainLeather</li>
        <li MayRequire="sarg.alphagenes">AG_TarBlood</li>        
        </genes>
      </li>
      <li Class="BigAndSmall.PawnExtension">
				<disableFacialAnimations>true</disableFacialAnimations>
        <bodyPaths>
          <Body_Female>Storageborn/Bodies/Luggage/Storageborn</Body_Female>
          <Body_Male>Storageborn/Bodies/Luggage/Storageborn</Body_Male>
          <Body_Thin>Storageborn/Bodies/Luggage/Storageborn</Body_Thin>
          <Body_Fat>Storageborn/Bodies/Luggage/Storageborn</Body_Fat>
          <Body_Hulk>Storageborn/Bodies/Luggage/Storageborn</Body_Hulk>
        </bodyPaths>
      </li>
    </modExtensions>
  </GeneDef>   

