<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef Name="OMW_StorageStage" Abstract="True">
    <displayCategory>Storageborn</displayCategory>
    <exclusionTags>
      <li>OMW_StorageStage</li>
      <li>Body_Size_Multiplier</li>
    </exclusionTags>
    <geneClass>StoragebornXenotype.StoragebornSizeGene</geneClass>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <selectionWeight>1</selectionWeight>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
  </GeneDef>

  <GeneDef ParentName="OMW_StorageStage">
    <defName>OMW_StorageStage_4</defName>
    <label>Storageborn Gigantism</label>
    <description>Carriers of this gene have genetic gigantism</description>
    <iconPath>GeneIcons/BS_VeryScaleUp</iconPath>
    <displayOrderInCategory>1050</displayOrderInCategory>
    <forcedTraits>
      <li>
        <def>Gigantism</def>
      </li>
    </forcedTraits>
    <statFactors>
      <CarryingCapacity>2.0</CarryingCapacity>
      <VEF_MassCarryCapacity MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">2.0</VEF_MassCarryCapacity>
    </statFactors>
    <statOffsets>
      <VEF_MassCarryCapacity MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">150</VEF_MassCarryCapacity>
    </statOffsets>    
  </GeneDef>

