<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef ParentName="OMW_StorageBodyBase">
    <defName>OMW_StorageBodyMechLoader</defName>
    <label>SB Mech Loader</label>
    <labelShortAdj>Mech Loader</labelShortAdj>
    <description></description>
    <iconPath>Storageborn/Bodies/MechLoader/Storageborn_south</iconPath>
    <modExtensions>
      <li Class="StoragebornXenotype.StoragebornBodyCategoryExtension">
        <OMW_StoragebornCategory>OMW_StoragebornCategory_Spacer</OMW_StoragebornCategory>
      </li>
      <li Class="StoragebornXenotype.StoragebornBodyBackstoriesExtension">
        <backgrounds>
          <li>OMW_StoragebornChildhood_SpacerRobot</li>
        </backgrounds>
      </li>
      <li Class="StoragebornXenotype.StoragebornBodyGenesExtension">
        <genes>
        <li>AptitudeStrong_Melee</li>        
        <li>AptitudeRemarkable_Construction</li>
        <li>AptitudeTerrible_Intellectual</li>       
        <li>Beauty_Ugly</li>        
        <li>PsychicAbility_Deaf</li>                
        <li>BS_AnimalFriend</li>                      
        <li>Neversleep</li>     
        <li>VU_NoBlood</li>
        <li MayRequire="sarg.alphagenes">AG_NoLeather</li>
        <li MayRequire="sarg.alphagenes">AG_NoMeat</li>               
        <li>BS_PilotAssistible</li>        
        </genes>
      </li>        
      <li Class="BigAndSmall.PawnExtension">
        <disableFacialAnimations>true</disableFacialAnimations>
        <bodyPaths>
          <Body_Female>Storageborn/Bodies/MechLoader/Storageborn</Body_Female>
          <Body_Male>Storageborn/Bodies/MechLoader/Storageborn</Body_Male>
          <Body_Thin>Storageborn/Bodies/MechLoader/Storageborn</Body_Thin>
          <Body_Fat>Storageborn/Bodies/MechLoader/Storageborn</Body_Fat>
          <Body_Hulk>Storageborn/Bodies/MechLoader/Storageborn</Body_Hulk>
        </bodyPaths>
      </li>
    </modExtensions>
  </GeneDef>

