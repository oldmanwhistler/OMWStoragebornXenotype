<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ScenPartDef>
    <defName>OMW_StoragebornRuinSetup</defName>
    <label>Storageborn ruin start setup</label>
    <scenPartClass>StoragebornXenotype.ScenPart_StoragebornRuinSetup</scenPartClass>
    <category>Rule</category>
    <selectionWeight>0</selectionWeight>
    <summaryPriority>500</summaryPriority>
  </ScenPartDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>OMW_StoragebornRuins</defName>
    <label>Storageborn Ruins</label>
    <description>A lone wanderer discovers three Storageborn in cryosleep caskets inside a ruin.</description>
<scenario>
		<name>Storageborn Ruins</name>
		<summary>Three Storageborn in cryosleep caskets awaken to join a lone wanderer.</summary>
		<description>A lone wanderer discovers three Storageborn in cryosleep caskets inside a ruin.</description>
		<playerFaction>
			<def>PlayerFaction</def>
			<factionDef>PlayerColony</factionDef>
		</playerFaction>
		<parts>
			<li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
				<def>ConfigurePawnsXenotypes</def>
				<pawnChoiceCount>6</pawnChoiceCount>
				<xenotypeCounts>
					<li>
						<count>3</count>
						<requiredAtStart>True</requiredAtStart>
						<xenotype>omw_storageborn</xenotype>
						<allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
					</li>
				</xenotypeCounts>
			</li>
			<li Class="ScenPart_PlayerPawnsArriveMethod">
				<def>PlayerPawnsArriveMethod</def>
			</li>
			<li Class="ScenPart_Naked">
				<def>Naked</def>
				<chance>1</chance>
				<context>PlayerStarter</context>
				<hideOffMap>True</hideOffMap>
			</li>
			<li Class="ScenPart_StartingThing_Defined">
				<def>StartingThing_Defined</def>
				<thingDef>Silver</thingDef>
				<count>100</count>
			</li>
			<li Class="ScenPart_StartingThing_Defined">
				<def>StartingThing_Defined</def>
				<thingDef>MealSurvivalPack</thingDef>
				<count>100</count>
			</li>
			<li Class="ScenPart_StartingThing_Defined">
				<def>StartingThing_Defined</def>
				<thingDef>MedicineIndustrial</thingDef>
				<count>30</count>
			</li>
			<li Class="ScenPart_StartingThing_Defined">
				<def>StartingThing_Defined</def>
				<thingDef>ComponentIndustrial</thingDef>
				<count>60</count>
			</li>
			<li Class="ScenPart_StartingThing_Defined">
				<def>StartingThing_Defined</def>
				<thingDef>Bow_Short</thingDef>
				<count>2</count>
			</li>
			<li Class="ScenPart_StartingThing_Defined">
				<def>StartingThing_Defined</def>
				<thingDef>Apparel_Parka</thingDef>
				<stuff>DevilstrandCloth</stuff>
				<quality>Poor</quality>
			</li>
			<li Class="ScenPart_ScatterThingsNearPlayerStart">
				<def>ScatterThingsNearPlayerStart</def>
				<thingDef>Steel</thingDef>
				<count>250</count>
				<allowRoofed>True</allowRoofed>
			</li>
			<li Class="ScenPart_ScatterThingsNearPlayerStart">
				<def>ScatterThingsNearPlayerStart</def>
				<thingDef>WoodLog</thingDef>
				<count>300</count>
				<allowRoofed>True</allowRoofed>
			</li>
			<li Class="ScenPart_ScatterThingsAnywhere">
				<def>ScatterThingsAnywhere</def>
				<thingDef>MealSurvivalPack</thingDef>
				<count>30</count>
				<allowRoofed>True</allowRoofed>
			</li>
			<li Class="ScenPart_GameStartDialog">
				<def>GameStartDialog</def>
				<text />
				<textKey>GameStartDialog</textKey>
				<closeSound>GameStartSting</closeSound>
			</li>
			<li Class="KCSG.ScenPart_AddStartingStructure">
				<def>VFEC_AddStartingStructure</def>
				<spawnConduits>True</spawnConduits>
				<preGenClear>True</preGenClear>
				<structureLabel />
				<nearMapCenter>True</nearMapCenter>
				<allowFoggedPosition>True</allowFoggedPosition>
				<chooseFrom>
					<li>OMW_Storageborn_Ruins</li>
				</chooseFrom>
			</li>
			<li Class="StoragebornXenotype.ScenPart_StoragebornRuinSetup">
				<def>OMW_StoragebornRuinSetup</def>
			</li>
			<li Class="ScenPart_CreateQuest">
				<def>CreateQuest</def>
				<questDef>WandererJoins</questDef>
			</li>
		</parts>
	</scenario>
  </ScenarioDef>
</Defs>
