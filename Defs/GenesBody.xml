<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef ParentName="GeneJawBase">
    <defName>OMW_StorageHead</defName>
    <label>storage head</label>
    <description>Carriers of this gene have heads that are part of their body</description>
    <iconPath>GeneIcons/BS_DevourerHead</iconPath>
    <displayCategory>Storageborn</displayCategory>    
    <displayOrderInCategory>98</displayOrderInCategory>
    <renderNodeProperties Inherit="False">
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPaths>
          <li>Head/StoragebornHead</li>
        </texPaths>
        <useSkinShader>false</useSkinShader>
        <colorType>Skin</colorType>
        <drawData>
          <defaultData>
            <layer>52</layer>
          </defaultData>
        </drawData>
        <parentTagDef>Head</parentTagDef>
      </li>
    </renderNodeProperties>
    <selectionWeight>1</selectionWeight>
    <canGenerateInGeneSet>true</canGenerateInGeneSet>
    <hairTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>Bald</li>
      </tags>
    </hairTagFilter>
    <beardTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>NoBeard</li>
      </tags>
    </beardTagFilter>
    <modExtensions>
      <li Class="BetterPrerequisites.GeneExtension">
        <facialDisabler/>
      </li>
		</modExtensions>
  </GeneDef>

  <GeneDef Name="OMW_StorageBodyBase" Abstract="True">
    <displayCategory>Storageborn</displayCategory>
    <exclusionTags>
      <li>AG_Bodies</li>
      <li>Bodies</li>
      <li>Body</li>
      <li>BS_Body</li>
      <li>OMW_StorageBody</li>
    </exclusionTags>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>    
    <renderNodeProperties Inherit="False">
      <li>
        <parentTagDef>Body</parentTagDef>
      </li>
    </renderNodeProperties>
  </GeneDef>

