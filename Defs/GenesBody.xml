<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef ParentName="GeneJawBase">
    <defName>OMW_StorageHead</defName>
    <label>storage head</label>
    <description>Carriers of this gene have heads that are part of their body</description>
    <iconPath>GeneIcons/BS_DevourerHead</iconPath>
    <displayCategory>Storageborn</displayCategory>    
    <displayOrderInCategory>98</displayOrderInCategory>
    <graphicData>
      <graphicPaths>
        <li>Storageborn/Heads/StoragebornHead</li>
      </graphicPaths>
      <layer>PostSkin</layer>
      <colorType>Skin</colorType>				
      <useSkinShader>false</useSkinShader>
      <drawLoc>HeadTop</drawLoc>
      <drawOffset>(0, -0.00288, 0)</drawOffset>
      <drawIfFaceCovered>true</drawIfFaceCovered>						
    </graphicData>
    <selectionWeight>1</selectionWeight>
    <canGenerateInGeneSet>true</canGenerateInGeneSet>
    <hairTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>Bald</li>
      </tags>
    </hairTagFilter>
    <beardTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>NoBeard</li>
      </tags>
    </beardTagFilter>
    <modExtensions>
      <li Class="BetterPrerequisites.GeneExtension">
        <facialDisabler/>
      </li>
		</modExtensions>
  </GeneDef>

  <GeneDef Name="OMW_StorageBodyBase" Abstract="True">
    <displayCategory>Storageborn</displayCategory>
    <exclusionTags>
      <li>AG_Bodies</li>
      <li>Bodies</li>
      <li>Body</li>
      <li>BS_Body</li>
      <li>OMW_StorageBody</li>
    </exclusionTags>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>    
    <renderNodeProperties Inherit="False">
      <li>
        <parentTagDef>Body</parentTagDef>
      </li>
    </renderNodeProperties>
  </GeneDef>

    <GeneDef ParentName="OMW_StorageBodyBase">
    <defName>OMW_StorageBodyKallax</defName>
    <label>Storageborn Kallax Body</label>
    <labelShortAdj>Kallax Body</labelShortAdj>
    <description></description>
    <iconPath>UI/Genes/OMW_StorageKallax</iconPath>
    <exclusionTags></exclusionTags>
    <modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <bodyPaths>
          <Body_Female>Storageborn/Bodies/Kallax/Storageborn</Body_Female>
          <Body_Male>Storageborn/Bodies/Kallax/Storageborn</Body_Male>
          <Body_Thin>Storageborn/Bodies/Kallax/Storageborn</Body_Thin>
          <Body_Fat>Storageborn/Bodies/Kallax/Storageborn</Body_Fat>
          <Body_Hulk>Storageborn/Bodies/Kallax/Storageborn</Body_Hulk>
        </bodyPaths>
      </li>
    </modExtensions>
  </GeneDef> 
</Defs>