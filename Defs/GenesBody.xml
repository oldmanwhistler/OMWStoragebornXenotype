<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef ParentName="GeneJawBase">
    <defName>OMW_StorageHead</defName>
    <label>No head</label>
    <description>Carriers of this gene don't have individual heads. Their head is part of their body</description>
    <iconPath>Head/StoragebornHead</iconPath>
    <displayCategory>Storageborn</displayCategory>    
    <displayOrderInCategory>98</displayOrderInCategory>
    <renderNodeProperties Inherit="False">
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPaths>
          <li>Head/StoragebornHead</li>
        </texPaths>
        <useSkinShader>false</useSkinShader>
        <colorType>Skin</colorType>
        <drawData>
          <defaultData>
            <layer>52</layer>
          </defaultData>
        </drawData>
        <parentTagDef>Head</parentTagDef>
      </li>
    </renderNodeProperties>
    <selectionWeight>1</selectionWeight>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <hairTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>Bald</li>
      </tags>
    </hairTagFilter>
    <beardTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>NoBeard</li>
      </tags>
    </beardTagFilter>
    <modExtensions>
      <li Class="BetterPrerequisites.GeneExtension">
        <facialDisabler/>
      </li>
		</modExtensions>
  </GeneDef>

  <GeneDef Name="OMW_StorageBodyBase" Abstract="True">
    <displayCategory>Storageborn</displayCategory>
    <geneClass>StoragebornXenotype.StoragebornBodyGene</geneClass>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <exclusionTags>
      <li>AG_Bodies</li>
      <li>Bodies</li>
      <li>Body</li>
      <li>BS_Body</li>
      <li>OMW_StorageBody</li>    
    </exclusionTags>
    <biostatCpx>0</biostatCpx>
    <!-- metabolism is so high because the no clothes + no equip is such a huge debuff -->
    <biostatMet>15</biostatMet>    
    <renderNodeProperties Inherit="False">
      <li>
        <parentTagDef>Body</parentTagDef>
      </li>
    </renderNodeProperties>
  </GeneDef>
</Defs>