<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<GeneDef ParentName="OMW_StorageBodyBase">
    <defName>OMW_StorageBodyCardboard</defName>
    <label>SB Cardboard Box</label>
    <labelShortAdj>Cardboard Box</labelShortAdj>
    <description></description>
    <iconPath>Storageborn/Bodies/Cardboard/Storageborn_south</iconPath>
    <exclusionTags></exclusionTags>
    <modExtensions>
      <li Class="StoragebornXenotype.StoragebornBodyCategoryExtension">
        <OMW_StoragebornCategory>OMW_StoragebornCategory_Industrial</OMW_StoragebornCategory>
      </li>
      <li Class="StoragebornXenotype.StoragebornBodyBackstoriesExtension">
        <backgrounds>
          <li>OMW_StoragebornChildhood_IndustrialStorage</li>
        </backgrounds>
      </li>
      <li Class="StoragebornXenotype.StoragebornBodyGenesExtension">
        <genes>
        <li>AptitudeTerrible_Melee</li>
        <li>AptitudeStrong_Construction</li>
        <li>AptitudeRemarkable_Animals</li>               
        <li>AptitudeRemarkable_Crafting</li>        
        <li>Delicate</li>        
        <li>BS_Diet_Herbivore</li>
        <li>PsychicAbility_Deaf</li>
        <li>Beauty_Ugly</li>    
        <li>Neversleep</li>     
        <li>VU_NoBlood</li>
        <li>FireWeakness</li>
        <li>FireTerror</li>    
        <li>AnimalWarcall</li>                                            
        <li MayRequire="sarg.alphagenes">AG_NoLeather</li>
        <li MayRequire="sarg.alphagenes">AG_NoMeat</li>                 
        </genes>
      </li>        
      <li Class="BigAndSmall.PawnExtension">
				<disableFacialAnimations>true</disableFacialAnimations>
        <bodyPaths>
          <Body_Female>Storageborn/Bodies/Cardboard/Storageborn</Body_Female>
          <Body_Male>Storageborn/Bodies/Cardboard/Storageborn</Body_Male>
          <Body_Thin>Storageborn/Bodies/Cardboard/Storageborn</Body_Thin>
          <Body_Fat>Storageborn/Bodies/Cardboard/Storageborn</Body_Fat>
          <Body_Hulk>Storageborn/Bodies/Cardboard/Storageborn</Body_Hulk>
        </bodyPaths>
      </li>
    </modExtensions>
  </GeneDef>    

