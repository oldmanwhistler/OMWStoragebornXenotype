<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <GeneDef ParentName="OMW_StorageBodyBase">
    <defName>OMW_StorageBodyMaid</defName>
    <label>SB Maid Robot</label>
    <labelShortAdj>Maid Robot</labelShortAdj>
    <description></description>
    <iconPath>Storageborn/Bodies/Maid/Storageborn_south</iconPath>
    <exclusionTags></exclusionTags>
    <modExtensions>
      <li Class="StoragebornXenotype.StoragebornBodyCategoryExtension">
        <OMW_StoragebornCategory>OMW_StoragebornCategory_Ultra</OMW_StoragebornCategory>
      </li>
      <li Class="StoragebornXenotype.StoragebornBodyBackstoriesExtension">
        <backgrounds>
          <li>OMW_StoragebornChildhood_UltraRobot</li>
        </backgrounds>
      </li>
      <li Class="StoragebornXenotype.StoragebornBodyGenesExtension">
        <genes>
        <li>AptitudePoor_Melee</li>        
        <li>AptitudeRemarkable_Cooking</li>   
        <li>AptitudeStrong_Animals</li>                    
        <li>AptitudeTerrible_Artistic</li>
        <li>AptitudeStrong_Medicine</li>
        <li>AptitudePoor_Intellectual</li>                
        <li>BS_Diet_Fuel</li>         
        <li>PsychicAbility_Dull</li>  
        <li>BS_AnimalFriend</li>                      
        <li>Neversleep</li>     
        <li>VU_NoBlood</li>
        <li>Beauty_Beautiful</li>   
        <li>Libido_High</li>    
        <li>Aggression_DeadCalm</li>     
        <li>KindInstinct</li>                   
        <li>BS_PerfectMemory</li>        
        <li>BS_FoamSpray</li>
        <li>WoundHealing_Slow</li>              
        <li MayRequire="sarg.alphagenes">AG_NoLeather</li>
        <li MayRequire="sarg.alphagenes">AG_NoMeat</li>            
        <li MayRequire="sarg.alphagenes">AG_Clean</li>        
        <li MayRequire="sarg.alphagenes">AG_MiningYield_Low</li>        
        </genes>
      </li>        
      <li Class="BigAndSmall.PawnExtension">
				<disableFacialAnimations>true</disableFacialAnimations>
        <bodyPaths>
          <Body_Female>Storageborn/Bodies/Maid/Storageborn</Body_Female>
          <Body_Male>Storageborn/Bodies/Maid/Storageborn</Body_Male>
          <Body_Thin>Storageborn/Bodies/Maid/Storageborn</Body_Thin>
          <Body_Fat>Storageborn/Bodies/Maid/Storageborn</Body_Fat>
          <Body_Hulk>Storageborn/Bodies/Maid/Storageborn</Body_Hulk>
        </bodyPaths>
      </li>    
    </modExtensions>
  </GeneDef>


